# ==============================================================================
# Selah Studio - Environment Configuration Example
# Copy this file to `.env` and configure your credentials.
# Note: Selah Studio works 100% offline with KJV Bible even without API keys!
# ==============================================================================

# 1. API.Bible Configuration (Optional - for online translations)
API_BIBLE_KEY=your_api_bible_key
VITE_API_BIBLE_ENDPOINT=https://rest.api.bible/v1

# Translation IDs on API.Bible
VITE_BIBLE_ID_KJV=de4e12af7f28f599-01
VITE_BIBLE_ID_NIV=78a9f6124f344018-01
VITE_BIBLE_ID_NKJV=63097d2a0a2f7db3-01
VITE_BIBLE_ID_NLT=d6e14a625393b4da-01
VITE_SCRIPTURE_BIBLE_ID=de4e12af7f28f599-01

# Desktop release builds must point to a deployed API server. Keep API_BIBLE_KEY
# and HF_ACCESS_TOKEN on that server; never expose provider credentials to the app.
VITE_TAURI_API_BASE_URL= # Required for desktop release online API features

# 2. Hugging Face Access Token & online Whisper models
HF_ACCESS_TOKEN=your_hugging_face_token
VITE_HF_MODEL_PRIMARY=openai/whisper-tiny
VITE_HF_MODEL_FALLBACK_1=openai/whisper-base
VITE_HF_MODEL_FALLBACK_2=openai/whisper-small
VITE_HF_MODEL_FALLBACK_3=openai/whisper-medium
# 3. Server & Local Network Configuration
PORT=3000
VITE_API_BASE_URL=
