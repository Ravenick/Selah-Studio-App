{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selah Studio",
  "version": "0.1.0",
  "identifier": "studio.selah.app",
  "build": {
    "beforeDevCommand": "pnpm run dev:tauri:web",
    "devUrl": "http://localhost:1420/studio",
    "beforeBuildCommand": "pnpm run build:tauri:web",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Selah Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 720,
        "url": "/studio"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "selah"
        ],
        "name": "Selah Studio Schedule",
        "description": "Selah Studio Worship Service Schedule File",
        "role": "Editor"
      }
    ]
  }
}
